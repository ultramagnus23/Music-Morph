{
  "name": "handshake",
  "productName": "HANDSHAKE",
  "version": "0.1.0",
  "description": "Gesture-controlled live music mangler",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && concurrently -k \"vite\" \"wait-on tcp:5173 && electron dist-electron/main.js\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && electron-builder",
    "sidecar:install": "pip install -r sidecar/requirements.txt",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
